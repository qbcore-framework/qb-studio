{
  "name": "@qbcore-framework/qb-studio-runtime",
  "version": "0.0.0-development",
  "description": "Private loopback runtime for QB Studio console logs and resource reloads.",
  "author": "QBCore Framework",
  "license": "MIT",
  "repository": "https://github.com/qbcore-framework/qb-studio",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "qb-studio-runtime": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run build && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=bundle/runtime.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

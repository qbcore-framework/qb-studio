{
  "name": "qb-studio-monorepo",
  "version": "0.0.0-development",
  "private": true,
  "description": "Build and release workspace for QB Studio.",
  "author": "QBCore Framework",
  "license": "MIT",
  "repository": "https://github.com/qbcore-framework/qb-studio",
  "workspaces": [
    "fivem-studio",
    "fivem-mcp-server"
  ],
  "scripts": {
    "build:runtime": "npm run bundle -w @qbcore-framework/qb-studio-runtime",
    "build:app": "npm run build -w qb-studio",
    "build": "npm run build:app",
    "check:static": "node scripts/check-repository.mjs",
    "typecheck": "npm run typecheck -w @qbcore-framework/qb-studio-runtime && npm run typecheck -w qb-studio",
    "test": "npm run test -w @qbcore-framework/qb-studio-runtime && npm run test -w qb-studio",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "prepare:luals": "node scripts/prepare-luals.mjs",
    "check:luals": "node scripts/check-luals-current.mjs",
    "verify:lua-definitions": "node scripts/verify-lua-definitions.mjs",
    "update:lua-definitions": "node scripts/update-lua-definitions.mjs",
    "dist": "npm run dist -w qb-studio",
    "verify:package": "node scripts/verify-package.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@electron/asar": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  },
  "overrides": {
    "dompurify": "3.4.14"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "koffi": true,
    "libxmljs2@0.37.0": true
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  }
}
